{% hw_extends 'storefront::component/navigation-dropdown-item.twig' %}

{% block navigation_navbar_left_item_dropdown_menu_item_classes %}
	{% apply spaceless %}
		{% if navigationChildItem.hasChildren() %}
			dropdown-toggle
		{% endif %}
	{% endapply %}
{% endblock %}

{% block navigation_navbar_left_item_dropdown_menu_item_dropdown %}
	<ul class="dropdown-menu booking theme" data-bs-popper="none">
		{% for childChildItem in navigationChildItem.getChildren() %}
			<li>
				{% hw_include 'storefront::component/navigation-dropdown-item.twig' with {
					navigationChildItem: childChildItem
				} %}
			</li>
		{% endfor %}
	</ul>
{% endblock %}
