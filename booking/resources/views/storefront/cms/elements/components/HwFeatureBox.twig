{% hw_extends 'storefront::cms/elements/components/HwFeatureBox.twig' %}

{% block hw_feature_box_component_wrapper %}

	<div class="feature col">
		<div class="card card-body shadow p-4 h-100 border-0">
			{{ block("hw_feature_box_component_icon") }}
			{{ block("hw_feature_box_component_title") }}
			{{ block("hw_feature_box_component_text") }}
		</div>
	</div>

{% endblock %}

{% block hw_feature_box_component_icon %}
	<div class="icon-lg {{ iconBackgroundClass|raw }} bg-opacity-10 text-primary rounded-circle mb-4">
		{{ icon|raw }}
	</div>
{% endblock %}

{% block hw_feature_box_component_title %}
	<h5>{{ title|raw }}</h5>
{% endblock %}

{% block hw_feature_box_component_text %}
	<p class="mb-0">{{ text|raw }}</p>
{% endblock %}