{% hw_extends 'storefront::layouts/navigation.twig' %}

{% block layouts_navigation %}
	<header class="navbar-light header-sticky">
		<!-- Logo Nav START -->
		<nav class="navbar navbar-expand-xl">
			<div class="container">
				{{ block("navigation_branding_wrapper") }}
				{{ block("navigation_toggler_wrapper") }}
				{{ block("navigation_navbar_left_wrapper") }}


			</div>
		</nav>
		<!-- Logo Nav END -->
	</header>
{% endblock %}

{% block navigation_branding_wrapper %}
	<a class="navbar-brand" href="{{ route('storefront.home') }}">
		{{ block("navigation_branding_inner") }}
	</a>
{% endblock %}

{% block navigation_toggler_wrapper %}
	<button class="navbar-toggler ms-auto ms-sm-0 p-0 p-sm-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-animation">
					<span></span>
					<span></span>
					<span></span>
				</span>
		<span class="d-none d-sm-inline-block small">Menu</span>
	</button>
{% endblock %}

{% block navigation_navbar_left_wrapper %}
	<div class="navbar-collapse collapse" id="navbarCollapse">
        <div class="d-flex flex-column ms-auto align-items-end">
            {{ block("navigation_navbar_right") }}
            {{ block("navigation_navbar_left") }}
        </div>
	</div>
{% endblock %}

{% block navigation_navbar_left %}
    <div class="d-sm-flex align-items-center justify-content-end w-100">
        <ul class="navbar-nav navbar-nav-scroll me-auto">
            {{ block("navigation_navbar_left_inner") }}
        </ul>
    </div>
{% endblock %}

{% block navigation_navbar_left_item_dropdown %}
	<li class="nav-item dropdown">
		{{ block("navigation_navbar_left_item_dropdown_link") }}
		{{ block("navigation_navbar_left_item_dropdown_menu") }}
	</li>
{% endblock %}

{% block navigation_navbar_left_item_dropdown_link %}
	<a class="nav-link dropdown-toggle" href="#" id="listingMenu" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
		{{ block("navigation_navbar_left_item_dropdown_content") }}
	</a>
{% endblock %}

{% block navigation_navbar_left_item_dropdown_menu_inner %}
	<li {% if navigationChildItem.hasChildren() %}class="dropdown-submenu dropend" {% endif %}>
		{{ block('navigation_navbar_left_item_dropdown_menu_inner_content') }}
	</li>
{% endblock %}

{% block navigation_navbar_left_item_dropdown_menu %}
	<ul class="dropdown-menu" aria-labelledby="listingMenu">
		{{ block("navigation_navbar_left_item_dropdown_menu_outer") }}
	</ul>
{% endblock %}

{% block navigation_navbar_right %}
		<ul class="navbar-nav navbar-nav-scroll nav-pills-primary-soft text-center ms-auto p-xl-0 border-bottom w-100 justify-content-end">
			{{ block("navigation_navbar_right_inner") }}
        </ul>
{% endblock %}

{% block navigation_navbar_right_cart_inner %}
	<li class="nav-item">
		<a class="nav-link small pb-2" href="{{ route('storefront.checkout.cart') }}">
			{{ block("navigation_navbar_cart_content") }}
		</a>
	</li>
{% endblock %}

{% block navigation_navbar_right_guest_button_login %}
	<li class="nav-item">
		<a class="nav-link small pb-2" href="{{ route('storefront.account.login') }}">
			{{ block("navigation_navbar_right_guest_button_login_content") }}
		</a>
	</li>
{% endblock %}

{% block navigation_navbar_right_guest_button_register %}
	<li class="nav-item">
		<a class="nav-link small pb-2" href="{{ route('storefront.account.register') }}">
			{{ block("navigation_navbar_right_guest_button_register_content") }}
		</a>
	</li>
{% endblock %}

{% block navigation_navbar_right_account_container %}
	{{ block("navigation_navbar_right_access") }}

	<li class="nav-item dropdown" style="position: relative">
		{{ block("navigation_navbar_right_account_button") }}
		{{ block("navigation_navbar_right_account_dropdown") }}
	</li>
{% endblock %}

{% block navigation_navbar_right_account_button %}
	<a class="nav-link dropdown-toggle active" href="{{ route('storefront.account.dashboard') }}" data-bs-toggle="dropdown">
		{{ block("navigation_navbar_right_account_button_content") }}
	</a>
{% endblock %}

{% block navigation_navbar_right__language_dropdown %}
    <li class="nav-item dropdown">
        <a class="nav-link small pb-2 dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown">
            <span class="flag-icon flag-icon-{{ locale.country|lower }}"></span>
            {{ locale.name }}
        </a>
        {{ block("navigation_navbar_right__language_dropdown_menu") }}
    </li>
{% endblock %}
