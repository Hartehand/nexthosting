{% hw_extends 'storefront::layouts/footer.twig' %}

{% block layouts_footer %}
<footer class="bg-dark text-light mt-auto">
    <div class="container py-5">
        {{ block("layouts_footer_inner") }}
    </div>

    <div class="bg-black bg-opacity-75 border-top border-secondary">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center py-2 small text-muted">
                <div>
                    v1.4.7 • © {{ "now"|date("Y") }} Nexthosting Friedl & Friedl GbR. Alle Rechte vorbehalten.
                </div>
                <div class="mt-1 mt-md-0 text-md-end">
                    Alle Preise sind Endpreise inkl. gesetzlicher Umsatzsteuer, sofern nicht anders angegeben.
                </div>
            </div>
        </div>
    </div>
</footer>
{% endblock %}

{% block layouts_footer_inner %}
<div class="row gy-4">

    <div class="col-12 col-lg-3">
        {{ block("layouts_footer_company") }}
    </div>

    <div class="col-6 col-lg-2">
        <h6 class="text-uppercase text-muted fw-semibold mb-3 small">Produkte</h6>
        <ul class="list-unstyled mb-0">
            <li><a href="/gameserver" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Gameserver</a></li>
            <li><a href="/vps" class="text-muted text-decoration-none text-primary-hover d-block mb-1">VPS-Server</a></li>
            <li><a href="/voiceserver" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Voiceserver</a></li>
            <li><a href="/status" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Status</a></li>
            <li><a href="/partner" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Für Studios & Projekte</a></li>
        </ul>
    </div>

    <div class="col-6 col-lg-2">
        <h6 class="text-uppercase text-muted fw-semibold mb-3 small">Unternehmen</h6>
        <ul class="list-unstyled mb-0">
            <li><a href="/ueber-uns" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Über uns</a></li>
            <li><a href="/rechenzentren" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Unsere Rechenzentren</a></li>
            <li><a href="/karriere" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Karriere</a></li>
            <li><a href="/partnerprogramm" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Partnerprogramm</a></li>
            <li><a href="/media" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Media & Presskit</a></li>
        </ul>
    </div>

    <div class="col-6 col-lg-2">
        <h6 class="text-uppercase text-muted fw-semibold mb-3 small">Legal</h6>
        <ul class="list-unstyled mb-0">
            <li><a href="/agb" class="text-muted text-decoration-none text-primary-hover d-block mb-1">AGB</a></li>
            <li><a href="/datenschutz" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Datenschutzerklärung</a></li>
            <li><a href="/impressum" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Impressum</a></li>
            <li><a href="/widerruf" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Widerrufsbelehrung</a></li>
            <li><a href="/cookie-einstellungen" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Cookie-Einstellungen</a></li>
        </ul>
    </div>

    <div class="col-6 col-lg-3">
        <h6 class="text-uppercase text-muted fw-semibold mb-3 small">Support &amp; Guides</h6>
        <ul class="list-unstyled mb-0">
            <li><a href="/faq" class="text-muted text-decoration-none text-primary-hover d-block mb-1">FAQ</a></li>
            <li><a href="/support" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Kundensupport</a></li>
            <li><a href="/guides" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Guides &amp; Dokus</a></li>
            <li><a href="/discord" class="text-muted text-decoration-none text-primary-hover d-block mb-1">Discord</a></li>
            <li><a href="/news" class="text-muted text-decoration-none text-primary-hover d-block mb-1">News &amp; Updates</a></li>
        </ul>
    </div>

</div>
{% endblock %}

{% block layouts_footer_company %}
<div class="mb-3">
    <a href="/" class="text-decoration-none d-inline-flex align-items-center mb-3">
        <div class="me-2 d-flex flex-column align-items-center">
            <span class="fw-bold fs-4 text-light lh-1">NEXTHOSTING</span>
            <span style="width:32px;height:3px;background:var(--bs-primary);margin-top:6px;border-radius:999px;"></span>
        </div>
    </a>

    <p class="text-muted small mb-1">Friedl &amp; Friedl GbR</p>
    <p class="text-muted small mb-1">Vetschauer Straße 19</p>
    <p class="text-muted small mb-1">01237 Dresden · Deutschland</p>

    {{ block("layouts_footer_company_vat") }}

    <p class="text-muted small mt-2 mb-0">
        {{ block("layouts_footer_powered_by") }}
    </p>
</div>
{% endblock %}

{% block layouts_footer_links %}{% endblock %}
{% block layouts_footer_link %}{% endblock %}
