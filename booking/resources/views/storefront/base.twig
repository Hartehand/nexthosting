{% hw_extends 'storefront::base.twig' %}

{% block base_scripts_custom %}

	<!-- Dark mode -->
	<script type="text/javascript">
        var theme = localStorage.getItem('data-theme');
        var root = document.documentElement;
        if (theme === 'dark' && theme !== undefined) {
            root.classList.add('dark-mode');
        } else {
            root.classList.remove('dark-mode');
        }
	</script>

	<!-- Vendors -->
	<script src="{{ asset('themes/hw/booking/vendor/tiny-slider/tiny-slider.js') }}?v={{ hwCacheId }}"></script>
	<script src="{{ asset('themes/hw/booking/vendor/glightbox/js/glightbox.js') }}?v={{ hwCacheId }}"></script>
	<script src="{{ asset('themes/hw/booking/vendor/flatpickr/js/flatpickr.min.js') }}?v={{ hwCacheId }}"></script>
	<script src="{{ asset('themes/hw/booking/vendor/choices/js/choices.min.js') }}?v={{ hwCacheId }}"></script>

	<!-- ThemeFunctions -->
	<script src="{{ asset('themes/hw/booking/js/functions.js') }}?v={{ hwCacheId }}"></script>

{% endblock %}