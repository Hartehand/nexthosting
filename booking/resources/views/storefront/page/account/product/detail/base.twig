{% hw_extends 'storefront::page/account/product/detail/base.twig' %}

{% block product_detail_page %}
	{{ block("product_detail_wrapper") }}
{% endblock %}

{% block product_detail_sidebar_wrapper %}
	<section class="col-md-12 pt-0 pb-4">
		<div class="card rounded-3 border p-3 pb-2">
			{{ block("product_detail_sidebar") }}
		</div>

		{{ block('product_detail_pending_rescales') }}
	</section>
{% endblock %}

{% block product_detail_sidebar %}
	{% set billingButtonClasses = 'btn-sm' %}
	{% set rescaleButtonClasses = 'btn-sm' %}

	<div class="d-sm-flex align-items-center justify-content-between">
		<div>
			{{ block("product_detail_title") }}

			<button class="btn btn-primary w-100 d-block d-xl-none mt-4 mb-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#dashboardMenu" aria-controls="dashboardMenu">
				<i class="far fa-bars"></i> Navigation
			</button>

			{{ block("product_detail_sidebar_pages") }}
		</div>

		<div>
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 6px">
				{{ block("product_detail_sidebar_actions_inner") }}
			</div>

			{{ block("product_detail_sidebar_rescale") }}
			{{ block("product_detail_sidebar_billing") }}
		</div>
	</div>

{% endblock %}

{% block product_detail_title %}
	<h4 class="ml-2 mt-2 d-flex align-items-center">
		{{ block("product_detail_title_content") }}
		{{ block("product_detail_status_wrapper") }}
	</h4>
{% endblock %}

{% block product_detail_sidebar_action_item %}
	<button
			data-bs-toggle="modal"
			data-bs-target="#hw-action-{{ actionName }}"
			class="btn btn-{{ actionItem.btnClass }} btn-sm"
			data-only-with-status="{{ actionItem.onlyWithStatuses|json_encode }}"
	>
		{{ block("product_detail_sidebar_action_item_content") }}
	</button>
{% endblock %}

{% block product_detail_sidebar_pages %}
	<div class="offcanvas-xl offcanvas-end hw-product-page-list" tabindex="-1" id="dashboardMenu">
		<div class="offcanvas-header border-bottom p-3">
			<h5 class="offcanvas-title">Menu</h5>
			<button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#dashboardMenu" aria-label="Close"></button>
		</div>

		<!-- Offcanvas body -->
		<div class="offcanvas-body p-3 p-xl-0">
			<!-- Nav item -->
			<div class="navbar navbar-expand-xl">
				<ul class="navbar-nav navbar-offcanvas-menu">
					{{ block("product_detail_sidebar_pages_inner") }}
				</ul>
			</div>
		</div>
	</div>
{% endblock %}

{% block product_detail_sidebar_page_item %}
	<li class="nav-item">
		<a
				class="nav-link {% if page == routeName %} active {% endif %}"
				href="{{ navItem.pageTarget.value == 'POPUP' ? '#' : routeHref }}"
				{% if navItem.pageTarget.value == 'BLANK_PAGE' %} target="_blank" {% endif %}
				{% if navItem.pageTarget.value == 'POPUP' %} onclick="window.HwOpenWindow('{{ routeHref }}', '{{ routeName }}-{{ productHosting.product_hosting_number }}', 800, 600);" {% endif %}
		>
			{{ block("product_detail_sidebar_page_item_content") }}
		</a>
	</li>
{% endblock %}

{% block product_detail_content %}
	<div class="col-md-12">
		{{ block("product_detail_content_inner") }}
	</div>
{% endblock %}
